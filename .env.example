BOX_HOST=127.0.0.1
BOX_PORT=8795
BOX_PUBLIC_URL=https://box.hacks.win
# Host con proxy de Cloudflare que recibe las partes de las subidas troceadas
BOX_UPLOAD_URL=https://boxup.hacks.win
BOX_CHUNK_MB=16
BOX_DATA_DIR=./data

# 64 caracteres hex. Si se omite se genera una en data/master.key
BOX_MASTER_KEY=

BOX_MAX_FILE_GB=5
BOX_CACHE_GB=40
BOX_MIN_FREE_GB=5
BOX_UPLOADS_PER_HOUR=120

# Sin estas tres variables el servicio funciona solo con el disco local
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER=boxhacks
