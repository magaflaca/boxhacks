{
  "name": "boxhacks",
  "version": "1.0.0",
  "description": "Alojamiento temporal de archivos con Google Drive cifrado como almacen",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "drive:auth": "node --env-file-if-exists=.env scripts/drive-auth.js"
  },
  "dependencies": {
    "busboy": "^1.6.0"
  }
}
